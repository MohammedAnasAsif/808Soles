{
  "name": "808soles",
  "productName": "808Soles",
  "version": "0.1.0",
  "description": "An open-source YouTube Music player for Windows and Android",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc -p . && vite build",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "youtubei.js": "^18.3.0",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "app.soles808.player",
    "productName": "808Soles",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "808Soles-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "808Soles",
      "artifactName": "808Soles-Setup-${version}.${ext}"
    },
    "asar": true
  }
}
